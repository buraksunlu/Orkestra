{
  "name": "orkestra",
  "productName": "Orkestra",
  "version": "0.1.0",
  "description": "Several Claude Code sessions in one window, with one shared status bar",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-builder install-app-deps",
    "test": "node --test test/*.test.js",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir && codesign --force --deep -s - dist/mac-arm64/Orkestra.app",
    "install-app": "npm run dist && rm -rf /Applications/Orkestra.app && cp -R dist/mac-arm64/Orkestra.app /Applications/",
    "e2e": "ELECTRON_RUN_AS_NODE=1 electron test/e2e/pty-e2e.js",
    "icon": "electron build/make-icon.js && sh build/make-icns.sh"
  },
  "build": {
    "appId": "local.orkestra.app",
    "productName": "Orkestra",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "files": [
      "src/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  }
}
